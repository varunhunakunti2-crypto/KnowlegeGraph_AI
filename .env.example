# KnowledgeGraph AI - Local Environment Configuration
# All inference runs locally. No paid APIs.

# Environment
ENV=development
DEBUG=true

# FastAPI Backend
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Next.js Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# Ollama (local LLM/embeddings)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_TIMEOUT=300
OLLAMA_TEMPERATURE=0.1
OLLAMA_MAX_TOKENS=2048

# Neo4j (Graph Database)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme
NEO4J_DATABASE=neo4j

# PostgreSQL + pgvector (Vector Store)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=knowledgegraph
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
DATABASE_URL=postgresql+psycopg://postgres:changeme@localhost:5432/knowledgegraph

# Embedding Configuration
EMBEDDING_DIMENSION=768  # nomic-embed-text dimension
EMBEDDING_BATCH_SIZE=32

# Chunking Configuration
CHUNK_SIZE=512
CHUNK_OVERLAP=50

# Retrieval Configuration
TOP_K_CHUNKS=10
TOP_K_ENTITIES=10
GRAPH_TRAVERSAL_DEPTH=2
MAX_CONTEXT_TOKENS=4096

# Ingestion
UPLOAD_DIR=./storage/uploads
MAX_UPLOAD_SIZE_MB=50
ALLOWED_EXTENSIONS=.pdf
MAX_PDF_PAGES=500
MAX_EXTRACTED_TEXT_CHARS=5000000
MAX_CHUNKS_PER_DOCUMENT=10000
# Reject PDFs with JavaScript/launch/embedded files by default. Only enable
# for a trusted local corpus and never serve uploaded files back to a browser.
ALLOW_PDF_ACTIVE_CONTENT=false
UPLOAD_PROCESS_TIMEOUT_SECONDS=180

# Resource Limits (RTX 4050 6GB VRAM, 16GB RAM)
MAX_CONCURRENT_REQUESTS=2
MAX_CONCURRENT_UPLOADS=2
MODEL_CONTEXT_LENGTH=4096
BATCH_SIZE=16
DB_CONNECT_TIMEOUT_SECONDS=5

# Retrieval / graph safety limits
TOP_K_CHUNKS=10
GRAPH_TRAVERSAL_DEPTH=2
MAX_GRAPH_TRAVERSAL_DEPTH=3
MAX_GRAPH_LIMIT=200
MAX_EVIDENCE_ITEMS=20
MAX_EVIDENCE_CHARS=4000
MAX_QUESTION_CHARS=2000
MAX_GRAPH_EXTRACTION_CHUNKS=100
GRAPH_EXTRACTION_TIMEOUT_SECONDS=600

# Logging
LOG_LEVEL=INFO
