# KnowledgeGraph AI - local environment configuration
# Copy this file to .env in the repository root and replace the passwords.
# All inference runs locally through Ollama. No paid APIs are used.

# Environment
ENV=development
DEBUG=true

# FastAPI backend
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
# Comma-separated exact origins. Wildcards are rejected by the backend.
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Next.js frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# Ollama (local LLM and embeddings)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_TIMEOUT=300
OLLAMA_TEMPERATURE=0.1
OLLAMA_MAX_TOKENS=2048
# Maximum generation attempts (0 is treated as one attempt; 1-5 otherwise).
OLLAMA_MAX_RETRIES=2
# How long Ollama keeps a model resident after a request ("5m", "30s", -1).
OLLAMA_KEEP_ALIVE=5m
# Unload this app's models after N idle seconds. 0 disables idle unload.
OLLAMA_IDLE_UNLOAD_SECONDS=900
# Prompt-processing batch. Lower (for example 128) reduces peak VRAM.
OLLAMA_NUM_BATCH=512
# Low-memory mode keeps only one of qwen3/nomic resident at a time.
OLLAMA_SINGLE_MODEL_RESIDENT=false

# Neo4j (graph database)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme
NEO4J_DATABASE=neo4j
NEO4J_QUERY_TIMEOUT_SECONDS=10

# PostgreSQL + pgvector (vector store)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=knowledgegraph
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
# Kept for external tooling. The backend uses the POSTGRES_* values above.
DATABASE_URL=postgresql+psycopg://postgres:changeme@localhost:5432/knowledgegraph

# Embedding configuration
# nomic-embed-text produces 768-dimensional vectors.
EMBEDDING_DIMENSION=768
EMBEDDING_BATCH_SIZE=32

# Chunking configuration
CHUNK_SIZE=512
CHUNK_OVERLAP=50

# Retrieval configuration
TOP_K_CHUNKS=10
TOP_K_ENTITIES=10
GRAPH_TRAVERSAL_DEPTH=2
MAX_CONTEXT_TOKENS=4096

# Ingestion
# A relative path is resolved from the process working directory. The
# documented backend command runs from backend/, so this is
# backend/storage/uploads.
UPLOAD_DIR=./storage/uploads
MAX_UPLOAD_SIZE_MB=50
ALLOWED_EXTENSIONS=.pdf
MAX_PDF_PAGES=500
MAX_EXTRACTED_TEXT_CHARS=5000000
MAX_CHUNKS_PER_DOCUMENT=10000
# Reject PDFs with JavaScript/launch/embedded files by default. Only enable
# this for a trusted local corpus. Uploaded files are never served back to a
# browser.
ALLOW_PDF_ACTIVE_CONTENT=false
UPLOAD_PROCESS_TIMEOUT_SECONDS=180

# Resource limits (RTX 4050 6 GB VRAM, 16 GB RAM)
# MEMORY_PROFILE=low-memory applies smaller context/batch/concurrency defaults
# for machines that are also running a browser and IDE. Explicit values below
# always override the profile, so comment out the individual settings in this
# section if you want the low-memory profile to control them.
MEMORY_PROFILE=default
MAX_CONCURRENT_REQUESTS=2
MAX_CONCURRENT_UPLOADS=2
MODEL_CONTEXT_LENGTH=4096
BATCH_SIZE=16
# Rows committed per indexing request. Small batches make indexing resumable.
INDEX_BATCH_SIZE=8
# Stop indexing after this many consecutive failed batches.
MAX_INDEX_BATCH_FAILURES=3
DB_CONNECT_TIMEOUT_SECONDS=5

# Memory guard: unload local models under pressure and after idle time.
MEMORY_GUARD_ENABLED=true
OLLAMA_UNLOAD_ON_MEMORY_PRESSURE=true
MIN_FREE_MEMORY_MB=1024
MIN_FREE_VRAM_MB=512
MEMORY_CHECK_INTERVAL_SECONDS=30

# Retrieval and graph safety limits
MAX_GRAPH_LIMIT=200
MAX_GRAPH_TRAVERSAL_DEPTH=3
MAX_GRAPH_EXTRACTION_CHUNKS=100
MAX_EVIDENCE_ITEMS=20
MAX_EVIDENCE_CHARS=4000
MAX_QUESTION_CHARS=2000
MAX_TOP_K=50
MAX_EXTRACTED_ENTITIES_PER_CHUNK=30
MAX_EXTRACTED_RELATIONSHIPS_PER_CHUNK=30
GRAPH_EXTRACTION_TIMEOUT_SECONDS=600

# Logging
LOG_LEVEL=INFO
